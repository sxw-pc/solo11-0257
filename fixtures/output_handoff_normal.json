{
  "job": "job-1",
  "pipe": "stdio-1",
  "generation": "stdio-1.gen0",
  "records": [
    {"id": "r1", "line": "parent=2\n"},
    {"id": "r2", "line": "worker=3\n"},
    {"id": "r3", "line": "next=4\n"}
  ],
  "events": [
    {"op": "start", "proc": "p1", "pid": 100, "job": "job-1", "ppid": null},
    {"op": "open", "proc": "p1", "handle": "h1", "pipe": "stdio-1", "generation": "stdio-1.gen0", "job": "job-1"},
    {"op": "write", "proc": "p1", "handle": "h1", "generation": "stdio-1.gen0", "fragment": "f1", "record": "r1", "seq": 1, "text": "parent=2\n"},
    {"op": "start", "proc": "p2", "pid": 200, "job": "job-1", "ppid": "p1"},
    {"op": "inherit", "handle": "h1", "from": "p1", "to": "p2", "as": "h2"},
    {"op": "close", "proc": "p1", "handle": "h1"},
    {"op": "exit", "proc": "p1"},
    {"op": "checkpoint", "id": "parent_exited_child_open"},
    {"op": "write", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f2", "record": "r2", "seq": 1, "text": "worker="},
    {"op": "write", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f3a", "record": "r2", "seq": 2, "text": "3", "delivery": "ack_lost"},
    {"op": "retry", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f3a", "record": "r2", "seq": 2, "text": "3"},
    {"op": "write", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f3b", "record": "r2", "seq": 3, "text": "\n", "delivery": "lost"},
    {"op": "retry", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f3b", "record": "r2", "seq": 3, "text": "\n"},
    {"op": "checkpoint", "id": "record_boundary_r2"},
    {"op": "write", "proc": "p2", "handle": "h2", "generation": "stdio-1.gen0", "fragment": "f4", "record": "r3", "seq": 1, "text": "next=4\n"},
    {"op": "close", "proc": "p2", "handle": "h2", "ack": "lost"},
    {"op": "exit", "proc": "p2"},
    {"op": "checkpoint", "id": "tree_closed"}
