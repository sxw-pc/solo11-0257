      "inject_at": {
        "record_boundary_r2": [
          {"op": "relay_request", "relay": "relay-1", "after_record": "r2"},
          {"op": "relay_confirm", "relay": "relay-1", "status": "confirmed"}
        ]
      },
      "claims": [
        {"artifact": "parent_download", "expect_text": "parent=2\nworker=3\n",
         "expect_records": ["r1", "r2"], "immutable": true, "must_not_contain": "next=4"},
        {"artifact": "child_download", "expect_text": "next=4\n",
         "expect_records": ["r3"], "immutable": true}
      ]
    }
  ]
