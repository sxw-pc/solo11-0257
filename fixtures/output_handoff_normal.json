  "scenarios": [
    {
      "id": "whole_tree",
      "consumers": [
        {"id": "parent_download", "policy": "job_tree", "job": "job-1", "generation": "stdio-1.gen0"}
      ],
      "inject_at": {
        "tree_closed": [
